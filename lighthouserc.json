{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4322 --host 127.0.0.1",
      "startServerReadyPattern": "4322",
      "url": [
        "http://127.0.0.1:4322/grupobarsol/",
        "http://127.0.0.1:4322/grupobarsol/servicios/movimiento-de-tierras/",
        "http://127.0.0.1:4322/grupobarsol/flota/",
        "http://127.0.0.1:4322/grupobarsol/contacto/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 92160 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
