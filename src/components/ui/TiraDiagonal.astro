---
// Tira de cortes de una misma foto (artboard D, «04 · Equipo»): tres paralelogramos con el ángulo del brazo, cada
// uno encuadrando otra parte de la foto. Es una sola imagen para el lector (role="img" con su texto alternativo).
// Entra con la pasada del brazo (data-diagonal + data-cortina), como DiagonalPanels.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img: ImageMetadata;
  alt: string;
  encuadres?: string[];
}
const { img, alt, encuadres = ['12% 50%', '52% 50%', '92% 50%'] } = Astro.props;
---

<div class="tira" role="img" aria-label={alt} data-diagonal>
  {
    encuadres.map((pos) => (
      <div class="tira__corte" data-panel style={`--pos: ${pos}`}>
        <Picture src={img} alt="" formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 64rem) 22vw, 40vw" loading="lazy" />
      </div>
    ))
  }
  <span class="tira__cortina" data-cortina aria-hidden="true"></span>
</div>

<style>
  @layer components {
    .tira {
      position: relative;
      container-type: size;
      display: flex;
      height: 9.5rem;
      overflow: hidden;
    }
    .tira__corte {
      flex: 1 1 0;
      min-width: 0;
      overflow: hidden;
      /* Paralelogramo: ambos lados al ángulo del brazo; los cortes se solapan para dejar una ranura pareja */
      margin-left: calc(-1 * var(--slope) * 100cqh + 0.5rem);
      clip-path: polygon(calc(var(--slope) * 100cqh) 0, 100% 0, calc(100% - var(--slope) * 100cqh) 100%, 0 100%);
    }
    .tira__corte:first-child {
      margin-left: 0;
    }
    .tira__corte:last-of-type {
      clip-path: polygon(calc(var(--slope) * 100cqh) 0, 100% 0, 100% 100%, 0 100%);
    }
    .tira__corte :global(picture),
    .tira__corte :global(img) {
      display: block;
      width: 100%;
      height: 100%;
    }
    .tira__corte :global(img) {
      object-fit: cover;
      object-position: var(--pos, 50% 50%);
    }
    .tira__cortina {
      position: absolute;
      inset-block: 0;
      left: calc(-1 * var(--slope) * 100cqh - 2px);
      z-index: 2;
      display: none;
      width: calc(100% + var(--slope) * 100cqh + 4px);
      background: var(--superficie, var(--c-paper));
      transform-origin: 0 100%;
      transform: skewX(calc(-1 * atan(var(--slope))));
    }
    @media (min-width: 64rem) {
      .tira {
        height: 18.75rem;
      }
    }
  }
</style>
