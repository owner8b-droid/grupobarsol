---
// Migas de pan de las páginas internas (sobre tinta, o sobre cal en la ficha de máquina). La última es la actual.
import { ruta, t } from '../../i18n/utils';

interface Miga {
  nombre: string;
  href?: string;
}
interface Props {
  migas?: Miga[];
  actual: string;
  tono?: 'oscuro' | 'claro';
}
const { migas = [], actual, tono = 'oscuro' } = Astro.props;
const todas: Miga[] = [{ nombre: t('es', 'ruta.inicio'), href: ruta('inicio') }, ...migas, { nombre: actual }];
---

<nav aria-label={t('es', 'ruta.label')} class:list={['migas', `migas--${tono}`]}>
  <ol role="list">
    {todas.map((m) => <li>{m.href ? <a href={m.href}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>)}
  </ol>
</nav>

<style>
  @layer components {
    .migas ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.6rem;
      margin: 0 0 1.5rem;
      font-size: 0.9375rem;
      font-weight: 700;
    }
    .migas--oscuro ol {
      color: var(--c-muted-dark);
    }
    .migas--claro ol {
      color: var(--c-muted);
    }
    .migas li + li::before {
      content: '/';
      margin-right: 0.6rem;
    }
    .migas--oscuro a {
      color: var(--c-paper-dim);
    }
    .migas--claro a {
      color: var(--c-ink);
    }
  }
</style>
