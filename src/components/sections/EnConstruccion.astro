---
// Página aún sin contenido (preview de la F4). Marcada como pendiente: el build de producción falla si queda.
import Button from '../ui/Button.astro';
import Pendiente from '../ui/Pendiente.astro';
import { enlaceWhatsApp, ruta, rutaCotizar } from '../../i18n/utils';
import { site } from '../../data/site';

interface Props {
  que: string;
}
const { que } = Astro.props;
---

<section class="construccion contenedor" aria-label="Contenido en preparación">
  <p><Pendiente texto={`${que}: se construye en la Fase 5`} /></p>
  <p>Mientras tanto, contanos qué necesitás y seguimos la conversación por WhatsApp.</p>
  <div class="acciones">
    <Button href={rutaCotizar()} tamano="l">Pre-cotizá tu obra</Button>
    <Button href={enlaceWhatsApp(site.whatsapp)} variante="borde" tamano="l" icono="whatsapp" evento="click_whatsapp">Escribinos por WhatsApp</Button>
  </div>
</section>

<style>
  .construccion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .construccion p + p {
    max-width: 36rem;
    color: var(--c-muted);
    font-size: var(--step-1);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
