---
// Sección «frente de obra» de D: columna de texto + bloque visual diagonal a sangre.
// Escritorio: pantalla completa con snap por proximidad. Móvil: altura natural.
// Con h1 es la cabecera de una página interna: el H1 es la frase completa en caja normal sobre la palabra (como el
// hero, ADR-011), la palabra se ve desde la carga (LCP, sin esperar al motor), las migas van en el slot «migas» y
// no hay snap (una página para leer no salta).
import TitleWord from '../ui/TitleWord.astro';

interface Props {
  id: string;
  eyebrow?: string;
  palabra: string;
  bajada: string;
  tono?: 'claro' | 'oscuro';
  invertida?: boolean;
  h1?: string;
  // Cabecera compacta: en una página de listado (la flota) lo que importa empieza en la primera pantalla
  compacta?: boolean;
}
const { id, eyebrow, palabra, bajada, tono = 'claro', invertida = false, h1, compacta = false } = Astro.props;
const cabecera = Boolean(h1);
---

<section
  id={id}
  class:list={['frente', `frente--${tono}`, { 'frente--invertida': invertida, 'frente--cabecera': cabecera, 'frente--compacta': compacta }]}
  aria-labelledby={cabecera ? `${id}-h1` : `${id}-titulo`}
  data-snap={cabecera ? undefined : ''}
  data-entrada
>
  {
    Astro.slots.has('tira') && (
      <div class="frente__tira">
        <slot name="tira" />
      </div>
    )
  }
  <div class="frente__texto">
    <slot name="migas" />
    {eyebrow && <p class="eyebrow frente__eyebrow" data-reveal={cabecera ? undefined : 'up'}>{eyebrow}</p>}
    {h1 && <h1 id={`${id}-h1`} class="frente__h1">{h1}</h1>}
    <TitleWord
      texto={palabra}
      as={cabecera ? 'p' : 'h2'}
      id={cabecera ? undefined : `${id}-titulo`}
      tono={tono}
      desde={invertida ? 'derecha' : 'izquierda'}
      revelar={!cabecera}
    />
    <p class="bajada frente__bajada" data-reveal={cabecera ? undefined : 'up'}>{bajada}</p>
    <div class="frente__cuerpo" data-reveal={cabecera ? undefined : 'up'}><slot /></div>
  </div>
  <div class="frente__visual"><slot name="visual" /></div>
</section>

<style>
  @layer components {
    .frente {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      overflow: hidden;
    }
    /* --superficie: color de la cortina de la pasada del brazo (DiagonalPanels) */
    .frente--claro {
      --superficie: var(--c-paper);
      background: var(--c-paper);
      color: var(--c-ink);
    }
    .frente--oscuro {
      --superficie: var(--c-ink);
      --c-focus: var(--c-accent); /* anillo ocre sobre tinta: 8,3:1 */
      background: var(--c-ink);
      color: var(--c-paper);
    }
    /* Tira de cortes arriba (04 · Equipo): fila propia; en escritorio arranca al 38 %, como el artboard */
    .frente__tira {
      flex: 0 0 100%;
    }
    .frente:has(.frente__tira) .frente__texto {
      padding-top: clamp(2.5rem, 4vw, 4rem);
    }
    .frente__texto {
      position: relative;
      z-index: 2;
      flex: 1 1 30rem; /* 30 + 32 < 64rem: lado a lado desde 1024 px */
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(4.5rem, 9vw, 9rem) 2.5rem clamp(3.5rem, 7vw, 6rem) var(--gutter-start);
    }
    /* Título de una palabra a su ancho (como el artboard): la franja se mide sobre la palabra, no sobre la columna.
       Del lado derecho la franja va hasta el borde de la página, así que ahí el título ocupa la columna. */
    .frente__texto :global(.palabra--izquierda) {
      align-self: flex-start;
    }
    .frente__eyebrow {
      margin-bottom: 1.1rem;
    }
    .frente--claro .frente__eyebrow {
      color: var(--c-muted);
    }
    .frente--oscuro .frente__eyebrow {
      color: var(--c-muted-dark);
    }
    /* La frase completa del H1 sobre la palabra, en caja normal (como .hero__h1) */
    .frente__h1 {
      max-width: 30rem;
      margin-bottom: 1.25rem;
      font-size: var(--step-1);
      font-weight: var(--weight-strong);
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    .frente__bajada {
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
    .frente__cuerpo {
      max-width: 33rem;
    }
    .frente--claro .frente__cuerpo :global(p) {
      color: var(--c-muted);
    }
    .frente--oscuro .frente__cuerpo :global(p) {
      color: var(--c-muted-dark);
    }
    .frente__cuerpo :global(p + *) {
      margin-top: 1.75rem;
    }
    .frente__visual {
      position: relative;
      flex: 1 1 32rem;
      min-width: 0;
      min-height: 22rem;
    }
    @media (max-width: 63.99rem) {
      /* Apilado y siempre con el texto primero (también en 02, que en escritorio va invertida) */
      .frente__texto,
      .frente__visual {
        flex-basis: 100%;
      }
      /* El bloque diagonal ya tiene alto propio (26rem, o 12rem la capa de 04 · Equipo) */
      .frente__visual {
        min-height: 0;
      }
    }
    @media (min-width: 64rem) {
      .frente {
        min-height: var(--section-min);
      }
      /* La cabecera arranca bajo el encabezado fijo: llena la primera pantalla sin pasarse */
      .frente--cabecera {
        min-height: calc(var(--section-min) - 5rem);
      }
      .frente--cabecera .frente__texto {
        padding-block: clamp(3.5rem, 6vw, 5rem);
      }
      .frente--compacta {
        min-height: 34rem;
      }
      .frente__tira {
        padding-left: 38%;
      }
      .frente--invertida .frente__texto {
        order: 2;
        padding-left: 2.5rem;
        padding-right: var(--gutter-end);
      }
    }
  }
</style>
