---
// Puntos de progreso del home (solo escritorio). scroll-target-group nativo + respaldo en lib/scrollspy.ts.
import { t } from '../../i18n/utils';
interface Props {
  secciones: { id: string; nombre: string }[];
}
const { secciones } = Astro.props;
---

<nav class="puntos" aria-label={t('es', 'secciones.label')} data-scrollspy>
  {
    secciones.map((s) => (
      <a href={`#${s.id}`} aria-current="false">
        <span class="visualmente-oculto">{s.nombre}</span>
        <span class="punto" aria-hidden="true" />
      </a>
    ))
  }
</nav>

<style>
  @layer components {
    .puntos {
      display: none;
    }
    @media (min-width: 64rem) {
      .puntos {
        position: fixed;
        top: 17rem;
        left: 1.1rem;
        z-index: 35;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding-block: 0.4rem;
        border-left: 2px solid color-mix(in oklch, var(--c-paper) 40%, transparent);
        scroll-target-group: auto;
      }
      a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        margin-left: -0.95rem;
      }
      .punto {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--c-accent);
        box-shadow: 0 0 0 3px color-mix(in oklch, var(--c-ink) 35%, transparent);
        transition: transform var(--dur-2) var(--ease-out);
      }
      a:is(:target-current, .is-current) .punto {
        transform: scale(1.75);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .punto {
        transition: none;
      }
    }
  }
</style>
