---
// Pestaña fija «Pre-cotizá tu obra» (solo escritorio). La conversión siempre a mano (BRIEF.md §2.1).
// Se oculta mientras el formulario está a la vista (lib/site.ts): no compite con él. En el cotizador no va.
import { destinoCotizar, t } from '../../i18n/utils';

const destino = destinoCotizar(Astro.url.pathname);
---

{
  destino !== Astro.url.pathname && (
    <a class="pestana" href={destino} data-pestana data-evento="cotizador_inicio" data-ubicacion="pestana">
      {t('es', 'cta.precotiza')}
    </a>
  )
}

<style>
  @layer components {
    .pestana {
      display: none;
    }
    @media (min-width: 64rem) {
      .pestana {
        position: fixed;
        top: 21rem;
        right: 0;
        z-index: 35;
        display: flex;
        align-items: center;
        padding: 1.85rem 0.95rem;
        border: 2px solid var(--c-ink);
        border-right: 0;
        border-radius: 0 0.6rem 0.6rem 0;
        background: var(--c-accent);
        color: var(--c-on-accent);
        font-size: 1.0625rem;
        font-weight: var(--weight-strong);
        text-decoration: none;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        transition:
          opacity var(--dur-2) var(--ease-out),
          visibility var(--dur-2) var(--ease-out);
      }
      /* Con el formulario a la vista, la pestaña se va (visibility: también sale del orden de tabulación) */
      .pestana:global(.is-oculta) {
        opacity: 0;
        visibility: hidden;
      }
      .pestana:hover {
        background: color-mix(in oklch, var(--c-accent) 86%, var(--c-ink));
      }
      .pestana:focus-visible {
        outline: 3px solid var(--c-ink);
        outline-offset: -7px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .pestana {
        transition: none;
      }
    }
  }
</style>
