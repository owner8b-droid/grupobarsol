---
// Flota (artboard Flota-escritorio · docs/02-estrategia.md §3): cabecera compacta de tinta, filtro por tipo con el
// conteo anunciado (lib/flota.ts; ?tipo= desde el home y el alquiler, contra la lista cerrada de los radios) y las
// tarjetas de cada unidad con su ficha. Sin JS se ven todas y el filtro no aparece.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frente from '../../components/sections/Frente.astro';
import Cierre from '../../components/sections/Cierre.astro';
import DiagonalPanels from '../../components/ui/DiagonalPanels.astro';
import Migas from '../../components/ui/Migas.astro';
import Chip from '../../components/ui/Chip.astro';
import TarjetaMaquina from '../../components/ui/TarjetaMaquina.astro';
import Pendiente from '../../components/ui/Pendiente.astro';
import { ORDEN_TIPOS, TIPOS, nombreUnidad, ordenUnidades, slugUnidad } from '../../data/flota';
import { ruta, rutaCotizar, rutaDeUnidad } from '../../i18n/utils';
import { listaDeUnidades, migas } from '../../lib/schema';
import nocheLowboy from '../../assets/img/noche-lowboy.jpg';
import vagonetas from '../../assets/img/vagonetas.jpg';

const unidades = (await getCollection('flota', (u) => u.data.lang === 'es')).sort(ordenUnidades);
const hayMuestras = unidades.some((u) => u.data.muestra);
if (hayMuestras && import.meta.env.PUBLIC_PRODUCCION === 'true') {
  throw new Error('La flota tiene unidades de muestra: falta el inventario real (pendiente #1).');
}
const tipos = ORDEN_TIPOS.filter((t) => unidades.some((u) => u.data.tipo === t));
const conteo = (n: number) => (n === 1 ? '1 máquina' : `${n} máquinas`);

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  listaDeUnidades(
    'Flota de maquinaria pesada en alquiler',
    url,
    unidades.map((u) => ({ nombre: nombreUnidad(u.data), url: new URL(rutaDeUnidad(slugUnidad(u)), Astro.site).href })),
  ),
  migas([{ nombre: 'Inicio', url: new URL(ruta('inicio'), Astro.site).href }, { nombre: 'Flota', url }]),
];
---

<Base
  title="Flota de maquinaria pesada en alquiler | Grupo Barsol"
  description="Excavadoras, compactadoras, niveladoras y vagonetas con su ficha técnica. Filtrá por tipo y cotizá la unidad que necesitás en Cartago."
  jsonLd={jsonLd}
>
  <Frente
    id="flota"
    h1="Flota de maquinaria pesada en alquiler"
    palabra="Flota"
    bajada="Excavadoras, compactadoras, niveladoras y vagonetas por hora, día o proyecto. Cada ficha trae los datos de la unidad."
    tono="oscuro"
    compacta
  >
    <Migas slot="migas" actual="Flota" />
    <DiagonalPanels
      slot="visual"
      prioridad
      principal={{ img: nocheLowboy, alt: 'Excavadora sobre una carreta durante un traslado nocturno', posicion: '62% 50%' }}
      capa={{ img: vagonetas, alt: '' }}
    />
  </Frente>

  <section class="unidades" aria-labelledby="unidades-titulo">
    <h2 id="unidades-titulo" class="visualmente-oculto">Unidades</h2>
    {
      hayMuestras && (
        <p class="unidades__aviso">
          <Pendiente texto="Unidades de muestra: falta el inventario real de la flota" />
        </p>
      )
    }
    <div class="unidades__barra">
      <fieldset class="filtro" data-filtro-flota>
        <legend class="eyebrow filtro__leyenda">Tipo</legend>
        <div class="filtro__chips">
          <Chip name="tipo" value="" checked data-singular="máquina" data-plural="máquinas">Todas</Chip>
          {
            tipos.map((t) => (
              <Chip name="tipo" value={t} data-singular={TIPOS[t].singular.toLowerCase()} data-plural={TIPOS[t].plural.toLowerCase()}>
                {TIPOS[t].plural}
              </Chip>
            ))
          }
        </div>
      </fieldset>
      <p class="unidades__conteo" data-conteo aria-live="polite">{conteo(unidades.length)}</p>
    </div>
    <ul role="list" class="unidades__lista">
      {
        unidades.map((u) => (
          <li data-unidad-tipo={u.data.tipo}>
            <TarjetaMaquina unidad={u} />
          </li>
        ))
      }
    </ul>
  </section>

  <Cierre
    titulo="¿No sabés qué máquina necesitás?"
    bajada="Contanos el trabajo y te recomendamos la adecuada."
    accion={{ href: rutaCotizar(), texto: 'Pre-cotizá tu obra' }}
    ubicacion="flota-cierre"
    mensajeWhatsApp="Hola, Grupo Barsol. Necesito una máquina y quiero que me recomienden la adecuada."
  />
</Base>

<style>
  @layer components {
    .unidades {
      padding: clamp(2.5rem, 5vw, 3.5rem) var(--gutter-end) clamp(4rem, 8vw, 6.5rem) var(--gutter-start);
      background: var(--c-paper);
      color: var(--c-ink);
    }
    .unidades__aviso {
      margin-bottom: 1.5rem;
      color: var(--c-muted);
    }
    .unidades__barra {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.125rem 2rem;
      margin-bottom: 2.25rem;
      padding-bottom: 1.75rem;
      border-bottom: 2px solid var(--c-ink);
    }
    /* El filtro solo existe con JS (lib/flota.ts); sin JS se ven todas las unidades */
    :global(html:not(.js)) .filtro {
      display: none;
    }
    .filtro {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.625rem 1rem;
      margin: 0;
      padding: 0;
      border: 0;
      min-width: 0;
    }
    .filtro__leyenda {
      float: left;
      padding: 0;
      color: var(--c-muted);
    }
    .filtro__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }
    .unidades__conteo {
      color: var(--c-muted);
      font-weight: 700;
    }
    .unidades__lista {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
      gap: 1.75rem;
      margin: 0;
    }
  }
</style>
