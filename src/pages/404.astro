---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { ruta } from '../i18n/utils';
---

<Base title="Página no encontrada | Grupo Barsol" description="Esta página no existe. Volvé al inicio o pre-cotizá tu obra." noindex>
  <section class="error404" aria-labelledby="e404-h1">
    <span class="error404__corte" aria-hidden="true"></span>
    <p class="error404__numero" aria-hidden="true">404</p>
    <h1 id="e404-h1">Esta página no existe.</h1>
    <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="error404__acciones">
      <Button href={ruta('inicio')} variante="claro" tamano="l">Volver al inicio</Button>
      <Button href={ruta('cotizador')} tamano="l">Pre-cotizá tu obra</Button>
    </div>
  </section>
</Base>

<style>
  .error404 {
    position: relative;
    overflow: hidden;
    min-height: 70svh;
    padding: clamp(4rem, 9vw, 8rem) var(--gutter-end) clamp(4rem, 9vw, 8rem) var(--gutter-start);
    background: var(--c-ink);
    color: var(--c-paper);
  }
  .error404__corte {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 34%;
    height: 50%;
    background: var(--c-accent);
    clip-path: polygon(62% 0, 100% 0, 100% 100%, 0 100%);
  }
  .error404__numero {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: var(--c-accent);
  }
  h1 {
    margin-top: 1.5rem;
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
  }
  h1 + p {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--c-paper-dim);
    font-size: var(--step-1);
  }
  .error404__acciones {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
